# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Never expose client-side

# ─── LemonSqueezy ──────────────────────────────────────────────────────────────
# Get these from: https://app.lemonsqueezy.com → Settings → API / Webhooks
LEMONSQUEEZY_API_KEY=your-ls-api-key-here
LEMONSQUEEZY_WEBHOOK_SECRET=your-ls-webhook-secret-here
LEMONSQUEEZY_STORE_ID=your-store-id-here

# Variant IDs for each plan (found in your LS product variants)
NEXT_PUBLIC_LS_PRO_VARIANT_ID=123456
NEXT_PUBLIC_LS_LIFETIME_VARIANT_ID=123457

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ytniches.com
# Local dev: NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin ─────────────────────────────────────────────────────────────────────
# The email address that can access /admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@ytniches.com
