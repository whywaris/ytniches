# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── YouTube Data API v3 ───────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ─── Anthropic Claude API (lib/ai/, TRD.md §6.2) ───────────────────────────
# Read automatically by @anthropic-ai/sdk's zero-arg `new Anthropic()`.
ANTHROPIC_API_KEY=

# ─── Upstash QStash (cron/background jobs) ────────────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── Inngest (TRD.md §4: channel-sync job + cron) ──────────────────────────
# Local dev only -- tells the SDK to talk to the local Inngest dev server
# (`pnpm dev:inngest`) instead of Inngest Cloud. Omit in production.
INNGEST_DEV=1

# ─── Upstash Redis (rate limiting) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Creem.io (payments) ───────────────────────────────────────────────────
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRO_PRODUCT_ID=
CREEM_TEAM_PRODUCT_ID=

# ─── Rewardful (affiliate) ─────────────────────────────────────────────────
REWARDFUL_API_SECRET=

# ─── Resend (email) ─────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Cron ────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Misc ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=

# ─── Sentry ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
