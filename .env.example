# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── YouTube Data API v3 ───────────────────────────────────────────────────
YOUTUBE_API_KEY=
# Optional per-category daily budgets (D-075), in YouTube units per Pacific
# quota day. Defaults: live 3500, sync 2000, free tools 1500, discovery 3000
# (until the D-036 quota increase lands). Each category stops at its own cap.
YT_BUDGET_LIVE=
YT_BUDGET_SYNC=
YT_BUDGET_FREE_TOOLS=
DISCOVERY_DAILY_BUDGET=

# ─── OpenAI API (lib/ai/, TRD.md §6.2, D-032) ──────────────────────────────
# Read automatically by openai's zero-arg `new OpenAI()`.
OPENAI_API_KEY=

# ─── Upstash QStash (cron/background jobs) ────────────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── Inngest (TRD.md §4: channel-sync job + cron) ──────────────────────────
# Local dev only -- tells the SDK to talk to the local Inngest dev server
# (`pnpm dev:inngest`) instead of Inngest Cloud. Omit in production.
INNGEST_DEV=1
# Production only (Inngest Cloud → your app → Manage → Keys). The SDK reads
# these itself: the signing key verifies Inngest's calls to /api/inngest,
# the event key lets the app send events. Leave empty locally.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ─── Upstash Redis (rate limiting) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Creem.io (payments, lib/billing/, Monetization.md §4, D-010) ──────────
# TRD.md §4.6's naming: test key used in dev + preview, prod key only in
# production, selected by NODE_ENV (lib/billing/creem.ts).
CREEM_API_KEY_TEST=
CREEM_API_KEY_PROD=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID_STARTER_MONTHLY=
CREEM_PRODUCT_ID_STARTER_YEARLY=
CREEM_PRODUCT_ID_PRO_MONTHLY=
CREEM_PRODUCT_ID_PRO_YEARLY=
CREEM_PRODUCT_ID_TEAM_MONTHLY=
CREEM_PRODUCT_ID_TEAM_YEARLY=
# Currently unused -- Creem's checkout is a server-created, hosted-checkout
# redirect (Monetization.md §4.4), not a client-embedded flow, so nothing
# in this codebase references a publishable key. Kept as a slot in case
# that changes.
NEXT_PUBLIC_CREEM_PUBLISHABLE_KEY=

# ─── Rewardful (affiliate) ─────────────────────────────────────────────────
REWARDFUL_API_SECRET=

# ─── Resend (email) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
# Blog newsletter signups land in this Resend segment (D-053)
RESEND_NEWSLETTER_SEGMENT_ID=

# ─── Cron ────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Misc ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=

# ─── Sentry ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ─── PostHog (analytics, lib/analytics/, TRD.md §6.5, Implementation-Plan.md §3.4)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
